        "editorWhitespace.foreground": "#26272b",
        "editorBracketMatch.background": "#1d1f22",
        "editorBracketMatch.border": "#3e4451",

        // Editor Gutter Colors
        "editorGutter.background": "#111113",
        "editorGutter.modifiedBackground": "#385775",
        "editorGutter.addedBackground": "#2c5222",
        "editorGutter.deletedBackground": "#5c1f1f",

        // Activity Bar Colors
        "activityBar.background": "#0a0a0b",
