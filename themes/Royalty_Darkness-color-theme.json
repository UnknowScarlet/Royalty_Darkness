        "breadcrumb.background": "#0c0c0d",
        "breadcrumb.foreground": "#888c99",
        "breadcrumb.focusForeground": "#B0B8C5",
        "breadcrumb.activeSelectionForeground": "#8FA0E9",

        // Debug Toolbar Colors
        "debugToolBar.background": "#1a1a1d",
        "debugToolBar.border": "#3e4451",

        // Dropdown Colors
        "dropdown.background": "#1a1a1d",
        "dropdown.border": "#3e4451",
        "dropdown.foreground": "#B0B8C5",

        // Input Colors
        "input.background": "#1a1a1d",
        "input.border": "#3e4451",
        "input.foreground": "#B0B8C5",
        "input.placeholderForeground": "#666a75",

        // Scrollbar Colors
        "scrollbarSlider.background": "#2e3640",
        "scrollbarSlider.hoverBackground": "#3b434f",
        "scrollbarSlider.activeBackground": "#4a4a4a",

        // Badge Colors
        "badge.background": "#8FA0E9",
        "badge.foreground": "#0c0c0d",

        // Minimap Colors
        "minimap.background": "#111113",
        "minimap.selectionHighlight": "#1f2a38",
        "minimap.errorHighlight": "#8c2f2f",
        "minimap.warningHighlight": "#978332",

        // List and Menu Colors
        "list.activeSelectionBackground": "#2e3640", // Fondo del elemento seleccionado
        "list.activeSelectionForeground": "#8FA0E9", // Texto del elemento seleccionado
        "list.inactiveSelectionBackground": "#141418",
        "list.inactiveSelectionForeground": "#B0B8C5",
        "list.hoverBackground": "#1f1f22", // Fondo al pasar el cursor sobre un elemento
        "list.hoverForeground": "#B0B8C5", // Texto al pasar el cursor sobre un elemento
        "menubar.selectionBackground": "#1a1a1d",
        "menubar.selectionForeground": "#B0B8C5",
        "menu.background": "#0c0c0d",
        "menu.foreground": "#B0B8C5",
        "menu.selectionBackground": "#1f1f22",
        "menu.selectionForeground": "#8FA0E9",
        "menu.separatorBackground": "#3e4451",

        // Button and Toolbar Colors
        "button.background": "#8FA0E9",
        "button.foreground": "#0c0c0d",
        "button.hoverBackground": "#A0B4F0",
        "button.border": "#6F8AC0",
        "toolbar.hoverBackground": "#8FA0E9",
        "toolbar.activeBackground": "#A0B4F0",

        // Git Decoration Colors
        "gitDecoration.addedResourceForeground": "#4CAF50",
        "gitDecoration.modifiedResourceForeground": "#8FA0E9",
        "gitDecoration.deletedResourceForeground": "#FF8281",
        "gitDecoration.untrackedResourceForeground": "#66BB6A",
        "gitDecoration.ignoredResourceForeground": "#546E7A",
        "gitDecoration.conflictingResourceForeground": "#DCAC69",
        "gitDecoration.submoduleResourceForeground": "#8FA0E9",

        // Quick Input Colors
        "quickInput.background": "#1a1a1d", // Fondo del Quick Open
        "quickInput.foreground": "#B0B8C5", // Texto del Quick Open
        "quickInputTitle.background": "#111113", // Fondo del título del Quick Open
        "pickerGroup.border": "#3e4451", // Borde entre grupos en el Quick Open
        "pickerGroup.foreground": "#8FA0E9" // Texto de los encabezados de grupo en el Quick Open
    },
    "tokenColors": [
        // Token Colors Section
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#546E7A"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.constant"
            ],
            "settings": {
                "foreground": "#BFC9DC"
            }
        },
        {
            "name": "Colors",
            "scope": [
                "constant.other.color"
            ],
            "settings": {
                "foreground": "#ffffff"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#53c6be"
            }
        },
        {
            "name": "Storage",
            "scope": [
                "storage.modifier",
                "storage.type"
            ],
            "settings": {
                "foreground": "#EE5E98"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type.function.arrow",
                "punctuation"
            ],
            "settings": {
                "foreground": "#81bcef"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
            ],
            "settings": {
                "foreground": "#81bcef"
            }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "meta.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": {
                "foreground": "#EE5E98"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": {
                "foreground": "#DB85E9"
            }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": {
                "foreground": "#8FA0E9"
            }
        },
        {
            "name": "Block Level Variables",
            "scope": [
                "meta.block variable.other"
            ],
            "settings": {
                "foreground": "#DB85E9"
            }
        },
        {
            "name": "Other Variable, String Link",
            "scope": [
                "support.other.variable",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#DB85E9"
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
            ],
            "settings": {
                "foreground": "#53C6BE"
            }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "variable.parameter",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": {
                "foreground": "#DCAC69"
            }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "punctuation.definition.string",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": {
                "foreground": "#54BDD0"
            }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": {
                "foreground": "#FF8281"
            }
        },
        {
            "name": "Entity Types",
            "scope": [
                "support.type"
            ],
            "settings": {
                "foreground": "#ff8282"
            }
        },
        {
            "name": "CSS Class and Support",
