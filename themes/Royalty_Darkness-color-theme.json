        // Panel Colors
        "panel.background": "#101113",
        "panel.border": "#1f1f22",

        // Terminal Colors
        "terminal.background": "#0c0c0d",
        "terminal.foreground": "#B0B8C5",
        "terminalCursor.foreground": "#8FA0E9",
        "terminal.ansiBlack": "#0c0c0d",
        "terminal.ansiRed": "#8c2f2f",
        "terminal.ansiGreen": "#347c4f",
        "terminal.ansiYellow": "#978332",
        "terminal.ansiBlue": "#395d82",
        "terminal.ansiMagenta": "#774a78",
        "terminal.ansiCyan": "#358596",
        "terminal.ansiWhite": "#b4b4b4",
        "terminal.ansiBrightBlack": "#4a4a4a",
        "terminal.ansiBrightRed": "#b84c4c",
        "terminal.ansiBrightGreen": "#4fa96b",
        "terminal.ansiBrightYellow": "#c4b343",
        "terminal.ansiBrightBlue": "#568ac4",
        "terminal.ansiBrightMagenta": "#9e65a1",
        "terminal.ansiBrightCyan": "#52a8c3",
        "terminal.ansiBrightWhite": "#e0e0e0",

        // Bracket Highlight Colors
        "editorBracketHighlight.foreground1": "#66b6bd",
        "editorBracketHighlight.foreground2": "#6289ad",
        "editorBracketHighlight.foreground3": "#8e76c4",
        "editorBracketHighlight.foreground4": "#b7799b",
        "editorBracketHighlight.foreground5": "#9dc665",
        "editorBracketHighlight.foreground6": "#cd8383",

