                "constant.other.reference.link.markdown"
            ],
            "settings": {
                "foreground": "#FF8281"
            }
        },
        {
            "name": "Markup - Raw Block",
            "scope": [
                "markup.raw.block"
            ],
            "settings": {
                "foreground": "#EE5E98"
            }
        },
        {
